{
	"name": "liber-music-player-plugin",
	"version": "1.4.0",
	"description": "Liber Music Player Plugin for Obsidian. Play local music files from the vault in the sidebar.",
	"main": "main.js",
	"type": "module",
	"author": "Liber Primus",
	"repository": {
		"type": "git",
		"url": "https://github.com/sudh29/liber_music.git"
	},
	"scripts": {
		"dev": "node scripts/deploy.mjs dev && node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && node scripts/deploy.mjs build",
		"test": "vp test run",
		"test:watch": "vp test",
		"test:coverage": "vp test run --coverage",
		"version": "node version-bump.mjs && git add package.json manifest.json versions.json",
		"lint": "vp lint .",
		"lint:eslint": "eslint .",
		"prepare": "vp config"
	},
	"keywords": [
		"Music",
		"Music Player",
		"Liber Music Player",
		"Liber Music Player Plugin",
		"Obsidian Plugin"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^22.15.17",
		"@types/react": "^18.2.0",
		"@types/react-dom": "^18.2.0",
		"@typescript-eslint/utils": "^8.54.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/coverage-v8": "5.0.5",
		"buffer": "^6.0.3",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"events": "^3.3.0",
		"globals": "^17.6.0",
		"happy-dom": "^21.0.4",
		"music-metadata": "^12.2.2",
		"oxc-transform-react": "^0.152.0",
		"process": "^0.11.10",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.72.0",
		"vite-plus": "1.4.0",
		"vitest": "5.0.5"
	},
	"dependencies": {
		"obsidian": "latest"
	},
	"overrides": {
		"moment": "^2.31.0",
		"brace-expansion": "^2.1.7",
		"fast-uri": "^3.1.8",
		"js-yaml": "^5.5.0",
		"file-type": "^22.2.0",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vitest": "5.0.5"
	},
	"allowScripts": {
		"esbuild": true
	}
}
