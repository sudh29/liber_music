# ============================================
# Obsidian Plugin Development Configuration
# ============================================
# 
# Usage Instructions:
# 1. Copy this file to .env
# 2. Enter your Obsidian Vault path
# 3. The .env file is included in .gitignore and will not be committed
# 
# Obsidian Vault Path:
# 
# Windows examples (forward slashes recommended):
# VAULT_PATH=C:/Users/YourName/Documents/MyVault
# VAULT_PATH=C:/Users/YourName/Documents/My Vault
# 
# Windows example with backslashes (requires escaping):
# VAULT_PATH=C:\\Users\\YourName\\Documents\\MyVault
# 
# macOS / Linux examples:
# VAULT_PATH=/Users/YourName/Documents/MyVault
# VAULT_PATH=/home/username/Documents/MyVault
# 
# Notes:
# - Forward slashes `/` are recommended on Windows; Node.js handles them automatically
# - If backslashes `\` are used, escape them as `\\`
# - Paths containing spaces do not require quotes
# - Comments can be added with `#`

VAULT_PATH=